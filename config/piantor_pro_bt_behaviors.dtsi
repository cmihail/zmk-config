smartnum_to_numsym: smartnum_switch_to_numsym {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&to 0>, <&numsym_fn_morph>;
};
esc_to_default: esc_and_exit_to_default {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&kp ESC>, <&to 0>;
};
space_adaptive: space_or_space_caps {
    compatible = "zmk,behavior-adaptive-key";
    #binding-cells = <0>;
    bindings = <&kp SPACE>;
    repeat {
        trigger-keys = <DOT QMARK EXCL>;
        bindings = <&space_caps>;
        max-prior-idle-ms = <1000>;
        strict-modifiers;
    };
};
space_adaptive_gallium: space_or_space_caps_gallium {
    compatible = "zmk,behavior-adaptive-key";
    #binding-cells = <0>;
    bindings = <&kp SPACE>;
    repeat {
        trigger-keys = <DOT QMARK EXCL>;
        bindings = <&space_caps_gallium>;
        max-prior-idle-ms = <1000>;
        strict-modifiers;
    };
};

