};

// Romanian magic key macros: backspace previous letter then emit RG(letter)
ro_a: romanian_a {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp RG(A)>;
};
ro_e: romanian_e {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp RG(E)>;
};
ro_i: romanian_i {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp RG(I)>;
};
ro_t: romanian_t {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp RG(T)>;
};
ro_s: romanian_s {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp RG(S)>;
};
ro_a_upper: romanian_a_upper {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp LS(RG(A))>;
};
ro_e_upper: romanian_e_upper {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp LS(RG(E))>;
};
ro_i_upper: romanian_i_upper {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp LS(RG(I))>;
};
ro_t_upper: romanian_t_upper {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp LS(RG(T))>;
};
ro_s_upper: romanian_s_upper {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_tap &kp BSPC &kp LS(RG(S))>;
};

// Romanian magic key: tap after a/e/i/t/s = backspace + RG(letter) for Romanian chars via XKB, otherwise = romanian_magic_upper (uppercase variant or sticky shift)
romanian_magic: romanian_magic_key {
    compatible = "zmk,behavior-adaptive-key";
    #binding-cells = <0>;
    bindings = <&romanian_magic_upper>;

    t_a {
        trigger-keys = <A>;
        bindings = <&ro_a>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
    t_e {
        trigger-keys = <E>;
        bindings = <&ro_e>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
    t_i {
        trigger-keys = <I>;
        bindings = <&ro_i>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
    t_t {
        trigger-keys = <T>;
        bindings = <&ro_t>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
    t_s {
        trigger-keys = <S>;
        bindings = <&ro_s>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
    t_undo {
        trigger-keys = <K_UNDO>;
        bindings = <&kp K_AGAIN>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
};

caps_word_morph: caps_word_or_shift {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&sk LSHFT>, <&caps_word>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

romanian_magic_upper: romanian_magic_upper_key {
    compatible = "zmk,behavior-adaptive-key";
    #binding-cells = <0>;
    bindings = <&caps_word_morph>;

    t_a {
        trigger-keys = <A>;
        bindings = <&ro_a_upper>;
        max-prior-idle-ms = <5000>;
    };
    t_e {
        trigger-keys = <E>;
        bindings = <&ro_e_upper>;
        max-prior-idle-ms = <5000>;
    };
    t_i {
        trigger-keys = <I>;
        bindings = <&ro_i_upper>;
        max-prior-idle-ms = <5000>;
    };
    t_t {
        trigger-keys = <T>;
        bindings = <&ro_t_upper>;
        max-prior-idle-ms = <5000>;
    };
    t_s {
        trigger-keys = <S>;
        bindings = <&ro_s_upper>;
        max-prior-idle-ms = <5000>;
    };
    t_undo {
        trigger-keys = <K_UNDO>;
        bindings = <&kp K_AGAIN>;
        max-prior-idle-ms = <5000>;
        strict-modifiers;
    };
};

