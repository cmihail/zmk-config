    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <225>;
    bindings = <&mo>, <&sl>;
};
space_caps: space_and_caps_layer {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <0>;
