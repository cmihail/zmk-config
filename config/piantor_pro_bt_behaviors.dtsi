    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&sl 2>, <&macro_release &kp LSHIFT &kp RSHIFT>;
};
smartnum_tap: smartnum_toggle_hold {
    compatible = "zmk,behavior-hold-tap";
