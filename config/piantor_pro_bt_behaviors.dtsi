    #binding-cells = <0>;
    bindings = <&kp RG(E)>, <&kp LS(RG(E))>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

// Leader key: Romanian letters and system controls
leader_key: leader_key {
    compatible = "zmk,behavior-leader-key";
    #binding-cells = <0>;
    ignore-keys = <LSHFT RSHFT>;
    // Romanian letters via Right Super: A=ă/Ă, E=â/Â, I=î/Î, T=ț/Ț, S=ș/Ș
    seq_a {
        sequence = <A>;
        bindings = <&ro_a_breve>;
    };
    seq_e {
        sequence = <E>;
        bindings = <&ro_a_circumflex>;
    };
    seq_i {
        sequence = <I>;
        bindings = <&ro_i_circumflex>;
    };
    seq_t {
        sequence = <T>;
        bindings = <&ro_t_cedilla>;
    };
    seq_s {
        sequence = <S>;
        bindings = <&ro_s_cedilla>;
    };
    // System controls
    seq_p {
        sequence = <P>;
        bindings = <&kp PSCRN>;
    };
    seq_zz {
        sequence = <Z Z>;
        bindings = <&kp C_SLEEP>;
    };
    // Volume controls
    seq_vu {
        sequence = <V U>;
        bindings = <&kp C_VOL_UP>;
    };
    seq_vd {
        sequence = <V D>;
        bindings = <&kp C_VOL_DN>;
    };
    seq_vm {
        sequence = <V M>;
        bindings = <&kp C_MUTE>;
    };
    // Media controls
    seq_mn {
        sequence = <M N>;
        bindings = <&kp C_NEXT>;
    };
    seq_mp {
        sequence = <M P>;
        bindings = <&kp C_PREV>;
    };
    seq_mt {
        sequence = <M T>;
        bindings = <&kp C_PP>;
    };
    // Brightness controls
    seq_bu {
        sequence = <B U>;
        bindings = <&kp C_BRI_UP>;
    };
    seq_bd {
        sequence = <B D>;
        bindings = <&kp C_BRI_DN>;
    };
    // Mic mute
    seq_mm {
        sequence = <M M>;
        bindings = <&kp F20>;
    };
    // Output mode
    seq_usb {
        sequence = <U S B>;
        bindings = <&out OUT_USB>;
    };
    seq_ble {
        sequence = <B L E>;
        bindings = <&out OUT_BLE>;
    };
    // Bluetooth controls
    seq_btn {
        sequence = <B T N>;
        bindings = <&bt BT_NXT>;
    };
    seq_btp {
        sequence = <B T P>;
        bindings = <&bt BT_PRV>;
    };
    seq_bt0 {
        sequence = <B T N0>;
        bindings = <&bt BT_SEL 0>;
    };
    seq_bt1 {
        sequence = <B T N1>;
        bindings = <&bt BT_SEL 1>;
    };
    seq_bt2 {
        sequence = <B T N2>;
        bindings = <&bt BT_SEL 2>;
    };
    seq_bt3 {
        sequence = <B T N3>;
        bindings = <&bt BT_SEL 3>;
    };
    seq_bt4 {
        sequence = <B T N4>;
        bindings = <&bt BT_SEL 4>;
    };
    seq_btc {
        sequence = <B T C>;
        bindings = <&bt BT_CLR>;
    };
    seq_btx {
        sequence = <B T X>;
        bindings = <&bt BT_CLR_ALL>;
    };
    // RGB controls removed: RGB underglow is compiled out (see defconfig).
};


