combos {
    compatible = "zmk,combos";

    // ===== TAB AND RETURN COMBOS (40ms timeout, 100ms require-prior-idle) =====
    combo_return {
        timeout-ms = <40>;
        require-prior-idle-ms = <100>;
        key-positions = <12 13>;  // T+S → Return
        bindings = <&kp RET>;
        layers = <0 1 2 3 4 5>;
    };
    combo_tab {
        timeout-ms = <40>;
        require-prior-idle-ms = <100>;
        key-positions = <16 17>;  // H+A → Tab
        bindings = <&kp TAB>;
        layers = <0 1 2 3 4 5>;
    };
    combo_left_click {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <5 6>;  // Z+F → Left Click
        bindings = <&mkp MB1>;
        layers = <0 1 2 3 4 5>;
    };
    combo_leader {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <15 16>;  // Y+H → Leader
        bindings = <&leader_key>;
        layers = <0 1 2 3 4 5>;
    };
    combo_middle_click {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <23 24>;  // W+J → Middle Click
        bindings = <&mkp MB3>;
        layers = <0 1 2 3 4 5>;
    };
    combo_escape {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <13 14>;  // S+G → Esc
        bindings = <&kp ESC>;
        layers = <0>;
    };
    combo_exit {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <13 14>;  // S+G → Exit to default layer
        bindings = <&to 0>;
        layers = <1 2 3 4 5 6>;
    };
    // ===== VERTICAL COMBOS (40ms timeout, 100ms require-prior-idle) =====
    // Symbol combos
    combo_semi {
        timeout-ms = <40>;
        require-prior-idle-ms = <100>;
        key-positions = <22 23>;  // M+W → ;
        bindings = <&kp SEMI>;
        layers = <0 1 2 3 4 5>;
    };
    combo_grave {
        timeout-ms = <18>;  // F and O are adjacent right-hand fingers, so "of"/"fo" rolls
                            // must fall outside the window; only a simultaneous press fires
        require-prior-idle-ms = <200>;
        key-positions = <6 7>;  // F+O → `
        bindings = <&kp GRAVE>;
        layers = <0 1 2 3 4 5>;
    };
    combo_colon {
        timeout-ms = <40>;
        require-prior-idle-ms = <100>;
        key-positions = <26 27>;  // P+, → :
        bindings = <&kp COLON>;
        layers = <0 1 2 3 4 5>;
    };
    combo_tilde {
        timeout-ms = <28>;
        require-prior-idle-ms = <250>;  // "ou" is a common bigram and O+U are same-hand neighbors;
                                        // long prior-idle disables this combo mid-word so it only fires
                                        // from a deliberate press after a pause/word boundary
        key-positions = <7 8>;  // O+U → ~
        bindings = <&kp TILDE>;
        layers = <0 1 2 3 4 5>;
    };
    combo_bspc {
        timeout-ms = <40>;
        require-prior-idle-ms = <150>;
        key-positions = <2 3>;  // D+C → BSPC
        bindings = <&kp BSPC>;
        layers = <0 1 2 3 4 5>;
    };

    // Edit combos
    combo_paste {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <1 11>;  // R+L → Paste
        bindings = <&kp K_PASTE>;
        layers = <0 1 2 3 4 5>;
    };
    combo_cut {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <11 13>;  // R+S → Cut
        bindings = <&kp K_CUT>;
        layers = <0 1 2 3 4 5>;
    };
    combo_copy {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <3 13>;  // S+C → Copy
        bindings = <&copy_cut>;
        layers = <0 1 2 3 4 5>;
    };
    combo_undo {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <3 4>;  // C+V → Undo
        bindings = <&undo_redo>;
        layers = <0 1 2 3 4 5>;
    };
    combo_mouse_up {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <2 12>;  // D+T → Mouse Up
        bindings = <&mmv MOVE_UP>;
        layers = <0 1 2 3 4 5>;
    };
    combo_mouse_left {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <11 21>;  // R+Q → Mouse Left
        bindings = <&mmv MOVE_LEFT>;
        layers = <0 1 2 3 4 5>;
    };
    combo_mouse_down {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <12 22>;  // T+M → Mouse Down
        bindings = <&mmv MOVE_DOWN>;
        layers = <0 1 2 3 4 5>;
    };
    combo_mouse_right {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <13 23>;  // S+W → Mouse Right
        bindings = <&mmv MOVE_RIGHT>;
        layers = <0 1 2 3 4 5>;
    };
    combo_scroll_up {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <4 14>;  // V+G → Scroll Up
        bindings = <&msc SCRL_UP>;
        layers = <0 1 2 3 4 5>;
    };
    combo_scroll_down {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <14 24>;  // G+J → Scroll Down
        bindings = <&msc SCRL_DOWN>;
        layers = <0 1 2 3 4 5>;
    };

    // Mouse click combos
    combo_delete {
        timeout-ms = <50>;
        require-prior-idle-ms = <150>;
        key-positions = <1 2>;  // L+D → Delete
        bindings = <&kp DEL>;
        layers = <0 1 2 3 4 5>;
    };
    combo_right_click {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <25 26>;  // K+P → Right Click
        bindings = <&mkp MB2>;
        layers = <0 1 2 3 4 5>;
    };

    // Navigation combos
    combo_page_up {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <5 15>;  // Z+Y → Page Up
        bindings = <&kp PG_UP>;
        layers = <0 1 2 3 4 5>;
    };
    combo_home {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <6 16>;  // F+H → Home
        bindings = <&home_morph>;
        layers = <0 1 2 3 4 5>;
    };
    combo_up {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <7 17>;  // O+A → Up
        bindings = <&kp UP>;
        layers = <0 1 2 3 4 5>;
    };
    combo_end {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <8 18>;  // U+E → End
        bindings = <&end_morph>;
        layers = <0 1 2 3 4 5>;
    };
    combo_page_down {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <15 25>;  // Y+K → Page Down
        bindings = <&kp PG_DN>;
        layers = <0 1 2 3 4 5>;
    };
    combo_left {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <16 26>;  // H+P → Left
        bindings = <&left_morph>;
        layers = <0 1 2 3 4 5>;
    };
    combo_down {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <17 27>;  // A+, → Down
        bindings = <&kp DOWN>;
        layers = <0 1 2 3 4 5>;
    };
    combo_right {
        timeout-ms = <50>;
        require-prior-idle-ms = <50>;
        key-positions = <18 28>;  // E+' → Right
        bindings = <&right_morph>;
        layers = <0 1 2 3 4 5>;
    };
};
